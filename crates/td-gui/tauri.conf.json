{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TempDirector",
  "version": "0.1.0",
  "identifier": "com.tempdirector.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TempDirector —— 缓存目录重定向",
        "width": 1240,
        "height": 800,
        "minWidth": 940,
        "minHeight": 580,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "shortDescription": "把软件缓存目录重定向到 RAM 盘",
    "longDescription": "用目录 Junction 把软件缓存/临时目录统一重定向到 RAM 盘，减少 SSD 写入；开机自动重建目标目录，保证链接始终有效。"
  }
}
