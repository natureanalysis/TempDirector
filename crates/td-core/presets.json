  },
  {
    "name": "WPS 缓存",
    "category": "office",
    "source_template": "%APPDATA%\\Kingsoft\\office6\\cache",
    "target_subpath": "office\\wps-cache",
    "note": "只迁 WPS 的资源缓存（*.keys/.values 与 *cache.merge 一类合并缓存）；程序组件与外壳扩展在 %LOCALAPPDATA%\\Kingsoft\\WPS Office，切勿迁移"
  },
  {
    "name": "飞书缓存",
    "category": "office",
    "source_template": "%APPDATA%\\LarkShell\\CodeCache",
    "target_subpath": "office\\lark-code-cache",
    "note": "只迁 V8 代码缓存；%APPDATA%\\LarkShell 是 Chromium 用户配置目录（含 Default、登录态、Local State），不可整体迁移"
  }
